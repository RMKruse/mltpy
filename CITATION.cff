    given-names: René-Marcel
    email: rene.marcel.kruse@protonmail.com
version: 0.4.0
license: MIT
repository-code: "https://github.com/RMKruse/mltpy"
url: "https://rmkruse.github.io/mltpy/"
keywords:
  - transformation model
  - survival analysis
  - censoring
  - conditional distribution
references:
