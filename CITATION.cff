    title: "Most Likely Transformations: The mlt Package"
    authors:
      - family-names: Hothorn
        given-names: Torsten
    journal: "Journal of Statistical Software"
    volume: 92
    issue: 1
    start: 1
    end: 68
    year: 2020
    doi: "10.18637/jss.v092.i01"
