> cat("-- mlt:::.log (log h'; h' < 0 -> -Inf)\n"); print(mlt:::.log)
-- mlt:::.log (log h'; h' < 0 -> -Inf)
function (x) 
{
    ret <- x
    if (any(is.na(x))) {
        ret[] <- -Inf
        return(ret)
    }
    neg <- x < 0
    if (any(neg, na.rm = TRUE)) {
        ret[neg] <- -Inf
        ret[!neg] <- log(x[!neg])
    }
    else {
        ret <- log(x)
    }
    dim(ret) <- dim(x)
    return(ret)
}
