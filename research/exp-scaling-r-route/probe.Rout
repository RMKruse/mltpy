> cat("-- mlt:::.mlt_loglik_exact\n");  print(mlt:::.mlt_loglik_exact)
-- mlt:::.mlt_loglik_exact
function (d, mm, mmprime, offset = 0, mmtrunc = NULL) 
{
    if (is.null(mmtrunc)) 
        return(function(beta) d$d(offset + .xmb(mm, beta), log = TRUE) + 
            .log(.xmb(mmprime, beta)))
    return(function(beta) d$d(offset + .xmb(mm, beta), log = TRUE) + 
        .log(.xmb(mmprime, beta)) - ..mlt_loglik_interval(d, 
        mmtrunc$left, mmtrunc$right, offset, beta))
}
<bytecode: 0xab3bc5b28>
<environment: namespace:mlt>
> cat("-- mlt:::.mlt_score_exact (dd2d = -1 for Exponential, everywhere)\n")
-- mlt:::.mlt_score_exact (dd2d = -1 for Exponential, everywhere)
> print(mlt:::.mlt_score_exact)
function (d, mm, mmprime, offset = 0, mmtrunc = NULL) 
{
    function(beta, Xmult = TRUE) {
        mmb <- drop(.xmb(mm, beta)) + offset
        ret <- d$dd2d(mmb)
        if (Xmult) 
            ret <- ret * mm + mmprime/drop(.xmb(mmprime, beta))
        if (!is.null(mmtrunc)) 
            ret <- ret - ..mlt_score_interval(d, mmtrunc$left, 
                mmtrunc$right, offset, beta, Xmult)
        return(ret)
    }
}
